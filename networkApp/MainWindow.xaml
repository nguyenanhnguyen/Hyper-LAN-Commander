<Window x:Class="networkApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hyper-LAN Commander" Height="500" Width="400" Background="#F0F2F5">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="HYPER-LAN COMMANDER" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Foreground="#1A73E8" Margin="0,0,0,20"/>

            <Border Background="White" CornerRadius="15" Padding="20" BorderBrush="#DADCE0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Địa chỉ IP của bạn:" FontSize="14" Foreground="#5F6368"/>
                    <TextBlock x:Name="txtIP" Text="Đang lấy IP..." FontSize="36" 
                               FontWeight="ExtraBold" HorizontalAlignment="Center" Foreground="#202124" Margin="0,10"/>
                    <TextBlock x:Name="txtStatus" Text="Trạng thái: Sẵn sàng" 
                               FontSize="12" Foreground="#34A853" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Máy tính tìm thấy:" Margin="0,20,0,5" FontWeight="Bold"/>
            <ListBox x:Name="lstDevices" Height="100" Margin="0,0,0,10"/>

            <Button x:Name="btnScan" Content="QUÉT MẠNG NỘI BỘ" Height="50"
                    Background="#1A73E8" Foreground="White" FontWeight="Bold" 
                    FontSize="16" Click="btnScan_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="25"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>