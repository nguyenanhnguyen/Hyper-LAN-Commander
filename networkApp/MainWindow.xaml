<Window x:Class="networkApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:networkApp"
        Title="Hyper-LAN Commander" Height="720" Width="1140" MinHeight="560" MinWidth="900"
        Background="{StaticResource ChatBg}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragOver"
        DragLeave="Window_DragLeave" Drop="Window_Drop">

    <Window.Resources>
        <!-- ============ Tin của mình ============ -->
        <DataTemplate x:Key="TplMine">
            <StackPanel HorizontalAlignment="Right" Margin="90,3,6,3">
                <Border Background="{StaticResource Primary}" CornerRadius="16,16,4,16" Padding="12,8" MaxWidth="560">
                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}"
                             Foreground="White" SelectionBrush="#93C5FD"/>
                </Border>
                <TextBlock HorizontalAlignment="Right" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,2,4,0">
                    <Run Text="{Binding Time, Mode=OneWay}"/>
                    <Run Text="{Binding Status, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- ============ Tin của bên kia ============ -->
        <DataTemplate x:Key="TplTheirs">
            <StackPanel HorizontalAlignment="Left" Margin="6,3,90,3">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="16,16,16,4" Padding="12,8" MaxWidth="560">
                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}"
                             Foreground="{StaticResource Text}"/>
                </Border>
                <TextBlock FontSize="10.5" Foreground="{StaticResource Muted}" Margin="4,2,0,0"
                           Text="{Binding Time, Mode=OneWay}"/>
            </StackPanel>
        </DataTemplate>

        <!-- ============ Dòng hệ thống ============ -->
        <DataTemplate x:Key="TplSystem">
            <Border HorizontalAlignment="Center" Margin="0,6" Padding="10,3" CornerRadius="10" Background="#E2E8F0">
                <TextBlock Text="{Binding Text}" FontSize="11.5" Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TplWarning">
            <Border HorizontalAlignment="Stretch" Margin="20,6" Padding="12,8" CornerRadius="10"
                    Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Warn}" BorderThickness="1">
                <TextBlock Text="{Binding Text}" FontSize="12.5" Foreground="{StaticResource WarnText}"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
        </DataTemplate>

        <!-- ============ Thẻ truyền file ============ -->
        <DataTemplate x:Key="TplTransfer">
            <Border DataContext="{Binding Transfer}" HorizontalAlignment="{Binding Alignment}"
                    Margin="6,6" Padding="14,12" Width="440" CornerRadius="14"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="iconBox" Width="44" Height="44" CornerRadius="12" VerticalAlignment="Top"
                            Background="{StaticResource PrimarySoft}">
                        <TextBlock x:Name="icon" Text="{Binding Icon}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource Primary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FileName}"/>
                        <TextBlock Text="{Binding MetaText}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/>
                        <TextBlock x:Name="status" Text="{Binding StatusText}" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource Primary}" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="bar" Style="{StaticResource SlimProgress}" Margin="0,7,0,0"
                                     Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                     Visibility="{Binding ShowProgress, Converter={StaticResource B2V}}"/>
                        <TextBlock Text="{Binding MetricsText}" FontSize="11" Foreground="{StaticResource Muted}"
                                   FontFamily="{StaticResource Mono}" Margin="0,5,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource BtnSuccess}" Content="{DynamicResource L_Accept}" Padding="16,6"
                                    Margin="0,0,8,0" Click="TransferAccept_Click"
                                    Visibility="{Binding CanDecide, Converter={StaticResource B2V}}"/>
                            <Button Style="{StaticResource BtnLight}" Content="{DynamicResource L_Decline}" Padding="14,6"
                                    Margin="0,0,8,0" Click="TransferDecline_Click"
                                    Visibility="{Binding CanDecide, Converter={StaticResource B2V}}"/>
                            <Button Style="{StaticResource BtnDangerSoft}" Content="{DynamicResource L_Cancel}" Padding="14,5"
                                    Margin="0,0,8,0" Click="TransferCancel_Click"
                                    Visibility="{Binding CanCancel, Converter={StaticResource B2V}}"/>
                            <Button Style="{StaticResource BtnLight}" Content="{DynamicResource L_ShowFile}" Padding="14,5"
                                    Click="TransferOpen_Click"
                                    Visibility="{Binding CanOpen, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Transfer.Tone}" Value="1">
                    <Setter TargetName="status" Property="Foreground" Value="{StaticResource SuccessText}"/>
                    <Setter TargetName="iconBox" Property="Background" Value="{StaticResource SuccessSoft}"/>
                    <Setter TargetName="icon" Property="Foreground" Value="{StaticResource SuccessText}"/>
                    <Setter TargetName="icon" Property="Text" Value="✓"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Transfer.Tone}" Value="2">
                    <Setter TargetName="status" Property="Foreground" Value="{StaticResource DangerText}"/>
                    <Setter TargetName="iconBox" Property="Background" Value="{StaticResource DangerSoft}"/>
                    <Setter TargetName="icon" Property="Foreground" Value="{StaticResource DangerText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Transfer.Tone}" Value="3">
                    <Setter TargetName="status" Property="Foreground" Value="{StaticResource WarnText}"/>
                    <Setter TargetName="iconBox" Property="Background" Value="{StaticResource WarnSoft}"/>
                    <Setter TargetName="icon" Property="Foreground" Value="{StaticResource WarnText}"/>
                    <Setter TargetName="bar" Property="Foreground" Value="{StaticResource Warn}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <local:ChatTemplateSelector x:Key="ChatSelector"
                                    Mine="{StaticResource TplMine}" Theirs="{StaticResource TplTheirs}"
                                    System="{StaticResource TplSystem}" Warning="{StaticResource TplWarning}"
                                    Transfer="{StaticResource TplTransfer}"/>

        <!-- ============ Một dòng peer ở sidebar ============ -->
        <DataTemplate x:Key="TplPeer">
            <Grid Margin="2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="40">
                    <Border CornerRadius="20" Background="#334155">
                        <TextBlock Text="{Binding Initials}" Foreground="{StaticResource SideText}" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="dot" Width="12" Height="12" CornerRadius="6" BorderBrush="{StaticResource SideBg}"
                            BorderThickness="2" Background="#64748B" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource SideText}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                        <Border Style="{StaticResource Pill}" Background="#1E40AF"
                                Visibility="{Binding IsNew, Converter={StaticResource B2V}}">
                            <TextBlock Text="{DynamicResource L_BadgeNew}" FontSize="9" FontWeight="Bold" Foreground="#BFDBFE"/>
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="#14532D"
                                Visibility="{Binding IsVerified, Converter={StaticResource B2V}}">
                            <TextBlock Text="✓" FontSize="9" FontWeight="Bold" Foreground="#86EFAC"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource SideMuted}" FontSize="11" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Endpoint, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="#64748B" FontSize="10.5" FontFamily="{StaticResource Mono}"
                               Text="{Binding ShortFingerprint}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border CornerRadius="9" Background="{StaticResource Primary}" MinWidth="18" Height="18" Padding="5,0"
                            HorizontalAlignment="Right"
                            Visibility="{Binding HasUnread, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding Unread}" FontSize="10.5" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="rtt" Text="{Binding RttText}" FontSize="10.5" Foreground="{StaticResource Success}"
                               FontFamily="{StaticResource Mono}" HorizontalAlignment="Right" Margin="0,3,0,0"
                               Visibility="{Binding HasRtt, Converter={StaticResource B2V}}"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="0">
                    <Setter TargetName="dot" Property="Background" Value="{StaticResource Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="1">
                    <Setter TargetName="dot" Property="Background" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="PeerItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="10" Padding="8" Margin="0,2" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SideHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SideSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MessageItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================= SIDEBAR ======================= -->
        <Border Grid.Column="0" Background="{StaticResource SideBg}">
            <Grid Margin="16,16,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#38BDF8" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="⇄" FontSize="20" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="HYPER-LAN" FontSize="17" FontWeight="Black" Foreground="{StaticResource SideText}"/>
                            <TextBlock Text="{DynamicResource L_Tagline}" FontSize="10.5" Foreground="{StaticResource SideMuted}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnSideIcon}" Content="📂" Margin="0,0,6,0"
                                ToolTip="{DynamicResource L_OpenDownloads}" Click="btnOpenDownloads_Click"/>
                        <Button x:Name="btnLang" Style="{StaticResource BtnSideIcon}" Width="34" FontSize="11"
                                Content="{DynamicResource L_LangToggle}" Click="btnLang_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Thẻ danh tính -->
                <Border Grid.Row="1" Background="{StaticResource SideCard}" CornerRadius="12" Padding="14,12"
                        Margin="0,16,0,0" BorderBrush="{StaticResource SideBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_YourIdentity}" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource SideMuted}"/>
                        <TextBlock x:Name="txtMyName" Text="…" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource SideText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="txtIP" Text="…" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"
                                   FontFamily="{StaticResource Mono}" Margin="0,2,0,0" Cursor="Help"/>
                        <Grid Margin="0,6,0,0">
                            <TextBlock x:Name="txtFingerprint" Text="" FontSize="12" Foreground="{StaticResource SideText}"
                                       FontFamily="{StaticResource Mono}" VerticalAlignment="Center"
                                       ToolTip="{DynamicResource L_FpTooltip}"/>
                            <Button Style="{StaticResource BtnSideIcon}" Content="⧉" HorizontalAlignment="Right"
                                    ToolTip="{DynamicResource L_CopyId}" Click="btnCopyId_Click"/>
                        </Grid>
                        <TextBlock x:Name="txtPorts" Text="" FontSize="10.5" Foreground="{StaticResource SideMuted}"
                                   FontFamily="{StaticResource Mono}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Tiêu đề danh sách -->
                <Grid Grid.Row="2" Margin="2,18,2,6">
                    <TextBlock Text="{DynamicResource L_Devices}" FontSize="10.5" FontWeight="Bold"
                               Foreground="{StaticResource SideMuted}"/>
                    <TextBlock x:Name="txtOnlineCount" HorizontalAlignment="Right" FontSize="10.5"
                               Foreground="{StaticResource Success}"/>
                </Grid>

                <!-- Danh sách peer -->
                <Grid Grid.Row="3">
                    <ListBox x:Name="lstPeers" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}"
                             ItemTemplate="{StaticResource TplPeer}" ItemContainerStyle="{StaticResource PeerItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="lstPeers_SelectionChanged"/>
                    <TextBlock x:Name="txtNoPeers" Text="{DynamicResource L_NoDevices}" Foreground="{StaticResource SideMuted}"
                               FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="12,24"
                               VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>

                <Button x:Name="btnScan" Grid.Row="4" Style="{StaticResource BtnPrimary}" Height="40" Margin="0,10,0,0"
                        FontSize="13.5" Click="btnScan_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳  "/>
                        <TextBlock Text="{DynamicResource L_Scan}"/>
                    </StackPanel>
                </Button>

                <Grid Grid.Row="5" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtManual" Style="{StaticResource InputDark}" Height="34" FontSize="12.5"
                             Tag="{DynamicResource L_ManualHint}" ToolTip="{DynamicResource L_ManualTooltip}"
                             KeyDown="txtManual_KeyDown"/>
                    <Button Grid.Column="2" x:Name="btnConnect" Style="{StaticResource BtnSide}" Height="34"
                            Content="{DynamicResource L_Connect}" Click="btnConnect_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ======================= CHAT ======================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border x:Name="pnlHeader" Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1" Padding="20,12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource PrimarySoft}">
                        <TextBlock x:Name="txtAvatar" FontWeight="Bold" Foreground="{StaticResource Primary}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtChatTitle" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                            <Border x:Name="badgeVerified" Style="{StaticResource Pill}" Background="{StaticResource SuccessSoft}"
                                    Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource L_BadgeVerified}" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessText}"/>
                            </Border>
                            <Border x:Name="badgeRtt" Style="{StaticResource Pill}" Background="#F1F5F9" Visibility="Collapsed">
                                <TextBlock x:Name="txtRtt" FontSize="10.5" FontFamily="{StaticResource Mono}"
                                           Foreground="{StaticResource Muted}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="txtChatSub" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="txtPeerFp" FontSize="11" Foreground="{StaticResource Muted}"
                                   FontFamily="{StaticResource Mono}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="btnSafety" Style="{StaticResource BtnLight}" VerticalAlignment="Center"
                            Click="btnSafety_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡  "/>
                            <TextBlock Text="{DynamicResource L_SafetyBtn}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Safety number -->
            <Border x:Name="pnlSafety" Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1" Padding="20,12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_SafetyTitle}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="{DynamicResource L_SafetyBody}" FontSize="11.5" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,2,0,8" MaxWidth="520" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="txtSafety" FontFamily="{StaticResource Mono}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}" LineHeight="28"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="btnVerify" Style="{StaticResource BtnSuccess}" VerticalAlignment="Center"
                            Click="btnVerify_Click"/>
                </Grid>
            </Border>

            <!-- Tin nhắn -->
            <Grid Grid.Row="2">
                <ListBox x:Name="lstMessages" Background="Transparent" BorderThickness="0" Padding="12,10"
                         FocusVisualStyle="{x:Null}"
                         ItemTemplateSelector="{StaticResource ChatSelector}"
                         ItemContainerStyle="{StaticResource MessageItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingPanel.ScrollUnit="Pixel"/>

                <!-- Màn hình chào -->
                <StackPanel x:Name="pnlEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                    <Border Width="84" Height="84" CornerRadius="24" HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#38BDF8" Offset="0"/>
                                <GradientStop Color="#2563EB" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="🔒" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource L_ChatEmptyTitle}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                    <TextBlock Text="{DynamicResource L_ChatEmptyBody}" Foreground="{StaticResource Muted}"
                               TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"/>
                    <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="18,14" Margin="0,20,0,0"
                            BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L_Feat1}" Foreground="{StaticResource Text}" Margin="0,3"/>
                            <TextBlock Text="{DynamicResource L_Feat2}" Foreground="{StaticResource Text}" Margin="0,3"/>
                            <TextBlock Text="{DynamicResource L_Feat3}" Foreground="{StaticResource Text}" Margin="0,3"/>
                            <TextBlock Text="{DynamicResource L_Feat4}" Foreground="{StaticResource Text}" Margin="0,3"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Lớp phủ kéo-thả -->
                <Border x:Name="pnlDrop" Margin="16" CornerRadius="16" Background="#CCDBEAFE" BorderBrush="{StaticResource Primary}"
                        BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⬇" FontSize="44" HorizontalAlignment="Center" Foreground="{StaticResource Primary}"/>
                        <TextBlock Text="{DynamicResource L_DropHere}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource Primary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ô nhập -->
            <Border x:Name="pnlInput" Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                    BorderThickness="0,1,0,0" Padding="16,12" IsEnabled="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnFile" Style="{StaticResource BtnLight}" Content="📎" FontSize="16" Width="44" Height="42"
                            Padding="0" ToolTip="{DynamicResource L_FileTooltip}" Click="btnFile_Click"
                            VerticalAlignment="Bottom"/>
                    <TextBox Grid.Column="2" x:Name="txtInput" Style="{StaticResource Input}" MinHeight="42" MaxHeight="140"
                             FontSize="14" AcceptsReturn="True" TextWrapping="Wrap" Padding="12,10"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             Tag="{DynamicResource L_InputHint}" PreviewKeyDown="txtInput_PreviewKeyDown"/>
                    <Button Grid.Column="4" x:Name="btnSend" Style="{StaticResource BtnPrimary}" Height="42" Padding="22,0"
                            FontSize="14" Content="{DynamicResource L_Send}" Click="btnSend_Click" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================= STATUS BAR ======================= -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource StatusBg}" Padding="16,5">
            <Grid>
                <TextBlock x:Name="txtStatus" Text="{DynamicResource L_StatusReady}" Foreground="#CBD5E1" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" Margin="0,0,420,0"/>
                <TextBlock x:Name="txtNetStats" HorizontalAlignment="Right" Foreground="{StaticResource SideMuted}"
                           FontSize="11" FontFamily="{StaticResource Mono}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
