<Window x:Class="networkApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hyper-LAN Commander" Height="560" Width="820" Background="#F0F2F5"
        MinHeight="480" MinWidth="700">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== CỘT TRÁI: DISCOVERY ==================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="HYPER-LAN" FontSize="20" FontWeight="Bold"
                       Foreground="#1A73E8" HorizontalAlignment="Center"/>

            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14" Margin="0,12,0,0"
                    BorderBrush="#DADCE0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="IP của bạn:" FontSize="12" Foreground="#5F6368"/>
                    <TextBlock x:Name="txtIP" Text="..." FontSize="22" FontWeight="ExtraBold"
                               Foreground="#202124" HorizontalAlignment="Center" Margin="0,4"/>
                    <TextBlock x:Name="txtStatus" Text="Trạng thái: Sẵn sàng" FontSize="11"
                               Foreground="#34A853" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" Text="Thiết bị trong mạng:" Margin="0,14,0,4" FontWeight="Bold"/>

            <!-- Chọn 1 thiết bị ở đây = chọn người để chat bên phải -->
            <ListBox Grid.Row="3" x:Name="lstDevices"
                     SelectionChanged="lstDevices_SelectionChanged"
                     BorderBrush="#DADCE0"/>

            <Button Grid.Row="4" x:Name="btnScan" Content="QUÉT MẠNG" Height="42" Margin="0,10,0,0"
                    Background="#1A73E8" Foreground="White" FontWeight="Bold" FontSize="14"
                    Click="btnScan_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="21"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- ==================== CỘT PHẢI: CHAT PANEL ==================== -->
        <Border Grid.Column="2" Background="White" CornerRadius="12"
                BorderBrush="#DADCE0" BorderThickness="1">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="txtChatTitle"
                           Text="Chọn một thiết bị bên trái để bắt đầu chat"
                           FontSize="15" FontWeight="Bold" Foreground="#202124" Margin="0,0,0,8"/>

                <ListBox Grid.Row="1" x:Name="lstMessages" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="txtInput" Height="38" FontSize="14"
                             VerticalContentAlignment="Center" Padding="8,0"
                             KeyDown="txtInput_KeyDown"/>
                    <Button Grid.Column="2" x:Name="btnSend" Content="Gửi" Height="38"
                            Background="#34A853" Foreground="White" FontWeight="Bold"
                            Click="btnSend_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
