<UserControl x:Class="networkApp.SecurityCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:networkApp"
             x:Name="Root" Background="{StaticResource ChatBg}">
    <UserControl.Resources>
        <local:SeverityBrushConverter x:Key="SevBrush"/>
        <local:SeverityTextConverter x:Key="SevText"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="Intro" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Badge mức độ -->
        <DataTemplate x:Key="SevPill">
            <Border CornerRadius="5" Padding="7,2" Background="{Binding Converter={StaticResource SevBrush}}"
                    VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Converter={StaticResource SevText}}" Foreground="White" FontSize="10" FontWeight="Bold"/>
            </Border>
        </DataTemplate>

        <!-- Tab dạng pill -->
        <Style TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" CornerRadius="8" Padding="14,7" Margin="0,0,6,0" Background="Transparent">
                            <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{StaticResource Muted}" x:Name="cp"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SideBg}"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Console" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="#A7F3D0"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource S_Title}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                <TextBlock Text="{DynamicResource S_Subtitle}" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BtnLight}"
                    Click="btnExport_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⤓  "/>
                    <TextBlock Text="{DynamicResource S_Export}"/>
                </StackPanel>
            </Button>
        </Grid>

        <TabControl Grid.Row="1" x:Name="tabs" Background="Transparent" BorderThickness="0" Padding="0,12,0,0">

            <!-- ===================== TỔNG QUAN ===================== -->
            <TabItem Header="{DynamicResource S_TabOverview}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="5" Margin="-6,0">
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_CardDevice}" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="ovScore" Text="—" FontSize="30" FontWeight="Black" Margin="0,4,0,0"/>
                                <TextBlock x:Name="ovScoreSub" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_CardLan}" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="ovLan" Text="—" FontSize="30" FontWeight="Black" Margin="0,4,0,0"/>
                                <TextBlock x:Name="ovLanSub" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_CardMonitor}" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="ovMon" Text="—" FontSize="30" FontWeight="Black" Margin="0,4,0,0"/>
                                <TextBlock x:Name="ovMonSub" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_CardLab}" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="ovLab" Text="—" FontSize="30" FontWeight="Black" Margin="0,4,0,0"/>
                                <TextBlock x:Name="ovLabSub" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_CardProtocol}" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="ovProto" Text="0" FontSize="30" FontWeight="Black" Margin="0,4,0,0"/>
                                <TextBlock x:Name="ovProtoSub" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Grid.Row="1" Text="{DynamicResource S_Events}" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource Text}" Margin="0,18,0,8"/>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
                        <Grid>
                            <ListBox x:Name="lstEvents" Style="{StaticResource PlainList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource Mono}" FontSize="11.5"
                                                       Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                            <ContentPresenter Grid.Column="1" Content="{Binding Severity}" ContentTemplate="{StaticResource SevPill}"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="txtNoEvents" Text="{DynamicResource S_NoEvents}" Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== KIỂM ĐỊNH LAN ===================== -->
            <TabItem Header="{DynamicResource S_TabLan}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource S_LanIntro}" Style="{StaticResource Intro}"/>
                    <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource S_Interface}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cmbIface" Width="300" Margin="0,0,16,0" VerticalContentAlignment="Center" Height="30"/>
                        <CheckBox x:Name="chkWhole" Content="{DynamicResource S_WholeSubnet}"/>
                        <CheckBox x:Name="chkConsent" Content="{DynamicResource S_Consent}" FontWeight="SemiBold"/>
                        <Button x:Name="btnScanLan" Style="{StaticResource BtnPrimary}" Content="{DynamicResource S_StartScan}"
                                Click="btnScanLan_Click" Margin="0,0,8,0"/>
                        <Button x:Name="btnStopLan" Style="{StaticResource BtnLight}" Content="{DynamicResource S_Stop}"
                                Click="btnStopLan_Click" IsEnabled="False"/>
                    </WrapPanel>
                    <Grid Grid.Row="2" Margin="0,12,0,8">
                        <ProgressBar x:Name="barLan" Style="{StaticResource SlimProgress}" Maximum="100" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtLanStatus" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,14,0,0"/>
                    </Grid>
                    <ListBox Grid.Row="3" x:Name="lstHosts" Style="{StaticResource PlainList}" Margin="0,8,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Ip}" FontFamily="{StaticResource Mono}" FontSize="15" FontWeight="Bold"
                                                           Foreground="{StaticResource Text}"/>
                                                <TextBlock Text="{Binding Tags}" FontSize="10.5" Foreground="{StaticResource Primary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Foreground="{StaticResource Text}">
                                                    <Run Text="{Binding HostName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text="  "/>
                                                    <Run Text="{Binding Vendor, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                                                </TextBlock>
                                                <TextBlock FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Muted}">
                                                    <Run Text="{Binding Mac, Mode=OneWay}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding Summary, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <ContentPresenter Grid.Column="2" Content="{Binding Risk}" ContentTemplate="{StaticResource SevPill}"
                                                              VerticalAlignment="Center"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Services}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontFamily="{StaticResource Mono}" Foreground="{StaticResource Text}">
                                                            <Run Text="{Binding PortText, Mode=OneWay}"/>
                                                            <Run Text="{Binding Service, Mode=OneWay}" FontWeight="Bold"/>
                                                        </TextBlock>
                                                        <ContentPresenter Grid.Column="1" Content="{Binding Risk}" ContentTemplate="{StaticResource SevPill}"/>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="{Binding Why}" FontSize="11.5" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Banner}" FontSize="11" FontFamily="{StaticResource Mono}"
                                                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                                       Visibility="{Binding HasBanner, Converter={StaticResource B2V}}"/>
                                                            <TextBlock Text="{Binding Issues}" FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource DangerText}" TextWrapping="Wrap"
                                                                       Visibility="{Binding HasIssues, Converter={StaticResource B2V}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ===================== MÁY NÀY ===================== -->
            <TabItem Header="{DynamicResource S_TabDevice}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{DynamicResource S_DeviceIntro}" Style="{StaticResource Intro}" Margin="0,6,200,12"/>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource BtnPrimary}"
                                Content="{DynamicResource S_RunAudit}" Click="btnAudit_Click" x:Name="btnAudit"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_CardDevice}" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="devScore" Text="—" FontSize="44" FontWeight="Black"/>
                                <TextBlock x:Name="devFacts" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8" MaxHeight="230">
                            <ListBox x:Name="lstFindings" Style="{StaticResource PlainList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Content="{Binding Severity}" ContentTemplate="{StaticResource SevPill}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Text}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{DynamicResource S_Listeners}" FontWeight="SemiBold" FontSize="14" Margin="0,0,16,0"/>
                            <CheckBox x:Name="chkExposed" Content="{DynamicResource S_OnlyExposed}" IsChecked="True"
                                      Checked="chkExposed_Changed" Unchecked="chkExposed_Changed"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1" x:Name="gridListeners" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource Border}"
                                  HorizontalGridLinesBrush="#EEF2F6" Background="White" RowBackground="White"
                                  CanUserResizeRows="False" SelectionMode="Single" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="60"/>
                                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="180"/>
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70"/>
                                <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="110"/>
                                <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="*"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== SOI GIAO THỨC ===================== -->
            <TabItem Header="{DynamicResource S_TabInspector}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource S_InspIntro}" Style="{StaticResource Intro}"/>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="chkCapture" Content="{DynamicResource S_Capture}" IsChecked="True"
                                      Checked="chkCapture_Changed" Unchecked="chkCapture_Changed"/>
                            <CheckBox x:Name="chkEaves" Content="{DynamicResource S_Eavesdrop}"
                                      Checked="chkEaves_Changed" Unchecked="chkEaves_Changed"/>
                            <Button Style="{StaticResource BtnLight}" Content="{DynamicResource S_Clear}" Click="btnClearTrace_Click" Padding="12,4"/>
                        </StackPanel>
                        <TextBlock x:Name="txtInspStats" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                    </Grid>
                    <Border Grid.Row="2" Background="#0B1220" CornerRadius="12" Padding="4">
                        <Grid>
                            <ListBox x:Name="lstTrace" Style="{StaticResource PlainList}" VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,3" TextElement.FontFamily="{StaticResource Mono}" TextElement.FontSize="11.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="104"/>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="74"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Direction}" Foreground="{Binding Accent}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Kind}" Foreground="{Binding Accent}"/>
                                            <TextBlock Grid.Column="3" x:Name="inner" Text="{Binding Inner}" Foreground="#E2E8F0" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Seq}" Foreground="#94A3B8"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Bytes}" Foreground="#94A3B8"/>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock x:Name="note" Text="{Binding Note}" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Hex}" Foreground="#475569" FontSize="10.5"/>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding EavesdropperMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                    <Condition Binding="{Binding IsSealed}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="inner" Property="Text" Value="?? (encrypted)"/>
                                                <Setter TargetName="inner" Property="Foreground" Value="#F87171"/>
                                                <Setter TargetName="note" Property="Text" Value="— ciphertext only: packet type &amp; content hidden · only size and timing are visible —"/>
                                                <Setter TargetName="note" Property="Foreground" Value="#F87171"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding EavesdropperMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                    <Condition Binding="{Binding IsLocalEvent}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Opacity" Value="0.3"/>
                                                <Setter TargetName="note" Property="Text" Value="— local computation inside the endpoint: never on the wire, invisible to an eavesdropper —"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="txtTraceHint" Text="{DynamicResource S_InspHint}" Foreground="#64748B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"
                                       TextAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== ATTACK LAB ===================== -->
            <TabItem Header="{DynamicResource S_TabLab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource S_LabIntro}" Style="{StaticResource Intro}"/>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Button x:Name="btnLab" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Click="btnLab_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚔  "/>
                                <TextBlock Text="{DynamicResource S_RunLab}"/>
                            </StackPanel>
                        </Button>
                        <StackPanel HorizontalAlignment="Right" Width="360" VerticalAlignment="Center">
                            <TextBlock x:Name="txtLabStatus" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                            <ProgressBar x:Name="barLab" Style="{StaticResource SlimProgress}" Maximum="13" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="2" x:Name="lstLab" Style="{StaticResource PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="124"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Border CornerRadius="6" Padding="8,4" Background="{Binding OutcomeBrush}" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding OutcomeText}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                            <TextBlock Text="{Binding Elapsed}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                                       FontFamily="{StaticResource Mono}" Margin="2,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Attack}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Text}"/>
                                            <TextBlock Text="{Binding Technique}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource Text}">
                                                <Run Text="🛡 " /><Run Text="{Binding Defense, Mode=OneWay}"/>
                                            </TextBlock>
                                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,5" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Evidence}" FontFamily="{StaticResource Mono}" FontSize="11.5"
                                                           Foreground="#334155" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ===================== CÔNG CỤ ===================== -->
            <TabItem Header="{DynamicResource S_TabTools}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource S_ToolsIntro}" Style="{StaticResource Intro}"/>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBox x:Name="txtTarget" Style="{StaticResource Input}" Width="260" Height="34"
                                 Tag="{DynamicResource S_Target}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource BtnPrimary}" Content="Ping" Click="btnPing_Click" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource BtnPrimary}" Content="Traceroute" Click="btnTrace_Click" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource BtnPrimary}" Content="DNS" Click="btnDns_Click" Margin="0,0,6,0"/>
                    </WrapPanel>
                    <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource S_LinkTest}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <ComboBox x:Name="cmbPeers" Width="280" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                  DropDownOpened="cmbPeers_DropDownOpened"/>
                        <Button Style="{StaticResource BtnSuccess}" Content="{DynamicResource S_Run}" Click="btnLinkTest_Click"/>
                    </WrapPanel>
                    <TextBox Grid.Row="3" x:Name="txtConsole" Style="{StaticResource Console}"/>
                </Grid>
            </TabItem>
        </TabControl>
